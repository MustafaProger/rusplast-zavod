# Include inside the HTTPS server block serving web/dist.
# Configure server_name, TLS and the actual document root on your host.
index index.html;
error_page 404 /404.html;

# Canonical routes have no .html suffix or trailing slash.
if ($request_uri ~ "^(.+)/index\.html(?:\?|$)") {
    return 308 $1$is_args$args;
}
if ($request_uri ~ "^/(index)\.html(?:\?|$)") {
    return 308 /$is_args$args;
}
if ($request_uri ~ "^(.+)\.html(?:\?|$)") {
    return 308 $1$is_args$args;
}
if ($request_uri ~ "^(.+)/+(?:\?|$)") {
    return 308 $1$is_args$args;
}

location = / {
    try_files /index.html =404;
}
location = /proizvodstvo-stm {
    return 301 "/#about";
}
location = /certificates {
    return 301 "/#certificates";
}
location = /404 {
    return 404;
}
location = /404.html {
    internal;
}
location / {
    # A real HTML page first; never substitute the homepage for unknown URLs.
    try_files $uri.html $uri =404;
}
