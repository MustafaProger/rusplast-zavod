# Copy outside the checkout to /etc/rusplast/production.env and chmod 600 it.
# Generate each secret independently; never use these empty values in production.
PUBLIC_URL=https://cms.rusplast-zavod.ru
# Replace before EACH build with a new, never-reused tag, e.g. UTC date + git SHA.
# Retain the previous tag, its images and matching release configuration.
RELEASE_TAG=replace-with-unique-release-tag
DATABASE_NAME=rusplast
DATABASE_USERNAME=rusplast
DATABASE_PASSWORD=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rusplastfactory@mail.ru
SMTP_PASSWORD=
LEAD_EMAIL_TO=rusplastfactory@mail.ru
